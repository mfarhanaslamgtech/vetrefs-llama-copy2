[Unit]
Description=VetRefs Llama chatbot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vetbot
Group=vetbot
WorkingDirectory=/opt/vetrefs-llama
EnvironmentFile=/opt/vetrefs-llama/.env
ExecStart=/opt/vetrefs-llama/.venv/bin/uvicorn app.app:app --host 127.0.0.1 --port 5000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
